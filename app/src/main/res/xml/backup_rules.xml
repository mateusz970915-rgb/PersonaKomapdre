<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for PersonaMesh — restrictive policy.
    
    See https://developer.android.com/guide/topics/data/autobackup
    See https://developer.android.com/about/versions/12/backup-restore
    
    Note: This policy applies to devices running API 31+
    Older devices use the device's system backup policy.
    
    PRINCIPLE: Exclude all sensitive data. Back up only application support files.
-->
<full-backup-content>
    <!-- 
        Exclude Room database: Contains agent state, missions, memories, 
        calendar sync, privacy audits, rules, and user conversations.
        Never back up without encryption.
    -->
    <exclude domain="database" path="*" />
    
    <!--
        Exclude shared preferences: May contain cached credentials, 
        API keys, tokens, and sensitive user settings.
    -->
    <exclude domain="sharedpref" path="*" />
    
    <!--
        Exclude cache: May contain temporary API responses, images, 
        and sensitive intermediate data.
    -->
    <exclude domain="cache" path="*" />
    
    <!--
        Include only application support files (logs, configs, non-PII).
        Future: if safe data exists, explicitly include by path.
    -->
    
</full-backup-content>
